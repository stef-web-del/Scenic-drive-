{
 "version": 8,
 "name": "Scenic Routes light (aus Tokens)",
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "sources": {
  "omt": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet",
   "attribution": "\u00a9 OpenStreetMap-Mitwirkende (ODbL) \u00b7 OpenFreeMap"
  }
 },
 "layers": [
  {
   "id": "land",
   "type": "background",
   "paint": {
    "background-color": "#F5F6FA"
   }
  },
  {
   "id": "forest",
   "type": "fill",
   "source": "omt",
   "source-layer": "landcover",
   "filter": [
    "==",
    "class",
    "wood"
   ],
   "paint": {
    "fill-color": "#D3DED6"
   }
  },
  {
   "id": "park",
   "type": "fill",
   "source": "omt",
   "source-layer": "park",
   "paint": {
    "fill-color": "#D3DED6",
    "fill-opacity": 0.5
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "omt",
   "source-layer": "water",
   "paint": {
    "fill-color": "#C9D6EA"
   }
  },
  {
   "id": "river",
   "type": "line",
   "source": "omt",
   "source-layer": "waterway",
   "paint": {
    "line-color": "#C9D6EA",
    "line-width": 1.5
   }
  },
  {
   "id": "road-minor+service+track",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "filter": [
    "in",
    "class",
    "minor",
    "service",
    "track"
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#FFFFFF",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     8,
     0.5,
     16,
     4
    ]
   }
  },
  {
   "id": "road-tertiary+secondary",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "filter": [
    "in",
    "class",
    "tertiary",
    "secondary"
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#FFFFFF",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     8,
     0.75,
     16,
     6
    ]
   }
  },
  {
   "id": "road-primary+trunk+motorway",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "filter": [
    "in",
    "class",
    "primary",
    "trunk",
    "motorway"
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#E0E3EC",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     8,
     1.0,
     16,
     8
    ]
   }
  },
  {
   "id": "place",
   "type": "symbol",
   "source": "omt",
   "source-layer": "place",
   "filter": [
    "in",
    "class",
    "town",
    "village",
    "city"
   ],
   "layout": {
    "text-field": "{name}",
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 12
   },
   "paint": {
    "text-color": "#4A5370",
    "text-halo-color": "#F5F6FA",
    "text-halo-width": 1.2
   }
  }
 ]
}