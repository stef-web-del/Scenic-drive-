# Erzeugt von install.sh aus Caddyfile.tmpl. __SITE__ = Domain (Auto-HTTPS) oder ":80".
{
	__EMAIL__
}
__SITE__ {
	encode gzip
	# Freie Rundensuche – die App ruft <basis>/jobs auf
	handle /jobs* {
		reverse_proxy 127.0.0.1:8765
	}
	handle /free/health {
		rewrite * /health
		reverse_proxy 127.0.0.1:8765
	}
	# Navigationsserver (wie Vercel): /health /scenic/* /route /trace_route /locate /height
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8002 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	log {
		output file /var/log/caddy/scenic.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
