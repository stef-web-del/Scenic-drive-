# /etc/scenic/scenic.env – Vorlage, KEINE echten Geheimnisse nötig. Kopieren und anpassen.
# Öffentlicher Name des Servers: Domain (dann holt Caddy automatisch ein HTTPS-Zertifikat)
# oder leer lassen -> Caddy lauscht nur auf Port 80 (http://<IP>), ohne Zertifikat.
SCENIC_DOMAIN=
# Kontakt-Mail für Let's Encrypt (optional)
SCENIC_ACME_EMAIL=
# Installationsort und Daten
SCENIC_ROOT=/srv/scenic/app
# Freie Rundensuche (server/server.py)
SCENIC_HOST=127.0.0.1
SCENIC_PORT=8765
# Rechenprozesse je Suche. 4 GB RAM: 3 (Spitze ~2,1 GB) oder 4 (~2,3 GB). Ergebnis identisch, nur Dauer ändert sich.
SCENIC_PROCS=3
# Navigationsserver (Valhalla, Endpunkte wie auf Vercel)
SCENIC_NAV_HOST=127.0.0.1
SCENIC_NAV_PORT=8002
SCENIC_NAV_TILE_DIR=/srv/scenic/app/valhalla/tiles
SCENIC_NAV_TMP=/var/lib/scenic/nav
# Valhalla-Kachelcache in Bytes (Vercel: 1 GB). 200 MB reicht für das Testgebiet, ändert keine Ergebnisse.
SCENIC_NAV_CACHE=200000000
# Quelle für Code-Updates (öffentliches Repo)
SCENIC_GIT_URL=https://github.com/stef-web-del/Scenic-drive-.git
SCENIC_GIT_BRANCH=main
