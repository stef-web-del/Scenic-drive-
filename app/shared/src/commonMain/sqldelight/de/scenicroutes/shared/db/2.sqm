-- Migration 2 -> 3: Fahrtaufzeichnung M4 (0.5.0-m4). Sync-fähig: UUID, Zeitstempel, Löschflag; Sensorspalten je GPS-Punkt.
ALTER TABLE Trip ADD COLUMN uuid TEXT;
ALTER TABLE Trip ADD COLUMN updatedMs INTEGER;
ALTER TABLE Trip ADD COLUMN deleted INTEGER NOT NULL DEFAULT 0;
ALTER TABLE Trip ADD COLUMN state TEXT NOT NULL DEFAULT 'done';
ALTER TABLE Trip ADD COLUMN durationS INTEGER;
ALTER TABLE Trip ADD COLUMN movingS INTEGER;
ALTER TABLE Trip ADD COLUMN ascentM REAL;
ALTER TABLE Trip ADD COLUMN descentM REAL;
ALTER TABLE Trip ADD COLUMN maxLonG REAL;
ALTER TABLE Trip ADD COLUMN maxLatG REAL;
ALTER TABLE Trip ADD COLUMN curves INTEGER;
ALTER TABLE Trip ADD COLUMN reversed INTEGER NOT NULL DEFAULT 0;
UPDATE Trip SET uuid = lower(hex(randomblob(16))), updatedMs = startedMs, state = CASE WHEN endedMs IS NULL THEN 'rec' ELSE 'done' END;
ALTER TABLE TrackPoint ADD COLUMN bearingDeg REAL;
ALTER TABLE TrackPoint ADD COLUMN lonG REAL;
ALTER TABLE TrackPoint ADD COLUMN latG REAL;
ALTER TABLE TrackPoint ADD COLUMN yawDps REAL;
ALTER TABLE TrackPoint ADD COLUMN gPeak REAL;
ALTER TABLE TrackPoint ADD COLUMN seg INTEGER NOT NULL DEFAULT 0;
